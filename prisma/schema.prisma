generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. USUÁRIOS E CONTAS (RBAC)
enum Role {
  ADMIN
  PRODUCTION
  FINANCIAL
  ATTENDANT
}

model User {
  id          String   @id @default(uuid())
  supabaseUid String?  @unique
  name        String
  email       String   @unique
  role        Role     @default(ADMIN)
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs AuditLog[]
}

// 2. INSUMOS / MATÉRIA-PRIMA
enum RawItemType {
  BLANK_SHIRT
  DTF_PRINT
  PACKAGING
  LABEL
  GIFT
}

model RawItem {
  id            String      @id @default(uuid())
  sku           String      @unique
  name          String
  type          RawItemType
  unit          String      @default("un") // un, m, kg
  stockQuantity Int         @default(0)
  minStock      Int         @default(10)
  costPrice     Float       @default(0.0) // Custo de aquisição unitário
  sellingPrice  Float       @default(0.0) // Preço de venda padrão sugerido
  description   String?     // Descrição detalhada do produto/insumo

  // Atributos específicos para Camisetas
  shirtModel    String?     // ex: Streetwear Oversized 26.1, Casual 30.1 Penteada
  shirtColor    String?     // ex: Preto, Off-White, Marrom, Chumbo
  shirtSize     String?     // ex: P, M, G, GG, XG

  // Atributos específicos para Estampa / Arte DTF
  dtfCode       String?     // ex: ART-001, ENCOMENDA-LUCAS
  dtfPreviewUrl String?     // URL da arte / mockup
  dtfPrintSize  String?     // ex: A3 (30x42cm), A4 (21x30cm), Bolso (10x10cm)
  dtfSupplier   String?     // Fornecedor de impressão DTF

  // Fornecedor padrão opcional
  supplierId    String?
  supplier      Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  isActive      Boolean     @default(true)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  bomItems      ProductBOM[]
  purchaseItems PurchaseOrderItem[]

  // Relações diretas com itens de pedidos sob encomenda
  orderItemBlankShirts OrderItem[] @relation("OrderItemBlankShirt")
  orderItemDtfPrints    OrderItem[] @relation("OrderItemDtfPrint")
  orderItemPackagings   OrderItem[] @relation("OrderItemPackaging")
}

// 3. PRODUTOS E VARIANTES (Opcional - para linhas fixas caso desejado)
model Product {
  id          String           @id @default(uuid())
  skuBase     String           @unique
  name        String
  category    String           @default("Camisetas")
  collection  String?
  targetMargin Float           @default(50.0)
  imageUrl          String?
  backImageUrl      String?
  description       String?
  showOnVirtualRack Boolean          @default(false)

  // Blend Mode & Posicionamento Dinâmico de Estampas
  baseShirtUrl      String?          // Mockup cinza liso frente
  baseShirtBackUrl  String?          // Mockup cinza liso costas
  printImageUrl     String?          // Arte/Estampa PNG isolada frente
  printBackImageUrl String?          // Arte/Estampa PNG isolada costas
  printWidth        Float?
  printTop          Float?
  printLeft         Float?
  printWidthBack    Float?
  printTopBack      Float?
  printLeftBack     Float?

  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  variants    ProductVariant[]
}

model ProductVariant {
  id             String       @id @default(uuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String       @unique
  title          String
  size           String
  color          String
  colorHex       String?
  imageUrl       String?
  backImageUrl   String?
  basePrice      Float
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bom            ProductBOM[]
  orderItems     OrderItem[]
}

// 4. BILL OF MATERIALS (BOM)
model ProductBOM {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  rawItemId   String
  rawItem     RawItem        @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  quantity    Int            @default(1)
  notes       String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([variantId, rawItemId])
}

// 5. PEDIDOS E ITENS SOB ENCOMENDA
enum SalesChannel {
  WHATSAPP
  INSTAGRAM
  MANUAL
  SHOPEE
  SHEIN
  TIKTOK
}

enum OrderStatus {
  PENDING
  NEW
  PAID
  WAITING_PRODUCTION
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique // ex: #CI-10492 ou SHOPEE-883921
  channel         SalesChannel   @default(WHATSAPP)
  status          OrderStatus    @default(WAITING_PRODUCTION)
  customerName    String
  customerEmail   String?
  customerPhone   String?
  shippingAddress String?
  paymentMethod   String?        @default("PIX") // PIX, CARTAO, DINHEIRO

  totalProducts   Float          @default(0.0)
  shippingCost    Float          @default(0.0)
  platformFee     Float          @default(0.0)
  netAmount       Float          @default(0.0)
  estimatedCMV    Float          @default(0.0)
  netProfit       Float          @default(0.0)

  notes           String?
  paidAt          DateTime?
  shippedAt       DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledBy     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           OrderItem[]
  productionJob   ProductionJob?
  financialTx     FinancialTransaction[]
  auditLogs       AuditLog[]
}

// ITEM DO PEDIDO: Adaptado para artes sob encomenda sem catálogo prévio
model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Vínculo opcional de variante pré-cadastrada (se houver)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Identificação da Encomenda Personalizada
  title           String          // ex: "Camiseta Oversized Preta G - Arte Lobo Costas"
  shirtModel      String?         // ex: Streetwear Oversized 26.1
  shirtColor      String?         // ex: Preto
  shirtSize       String?         // ex: G
  
  artTitle        String?         // Nome/descrição da estampa encomendada
  artMockupUrl    String?         // Link do arquivo da arte / mockup enviado
  printSize       String?         // A3 (30x42cm), A4 (21x30cm), Bolso

  // Insumos reais consumidos para baixa automática no estoque
  blankShirtId    String?
  blankShirt      RawItem?        @relation("OrderItemBlankShirt", fields: [blankShirtId], references: [id], onDelete: SetNull)

  dtfPrintId      String?
  dtfPrint        RawItem?        @relation("OrderItemDtfPrint", fields: [dtfPrintId], references: [id], onDelete: SetNull)

  packagingId     String?
  packaging       RawItem?        @relation("OrderItemPackaging", fields: [packagingId], references: [id], onDelete: SetNull)

  quantity        Int             @default(1)
  unitPrice       Float           // Preço de venda cobrado
  unitCost        Float           @default(0.0) // Custo de insumos somados
  total           Float

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// 6. FILA DE PRODUÇÃO (PRODUCTION JOB)
enum JobPriority {
  NORMAL
  HIGH
  URGENT
}

model ProductionJob {
  id              String      @id @default(uuid())
  orderId         String      @unique
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  priority        JobPriority @default(NORMAL)

  // Checklist de Produção On-Demand
  stepBlankPicked Boolean     @default(false) // 1. Separar Camiseta Lisa
  stepDtfPicked   Boolean     @default(false) // 2. Separar e Cortar Folha DTF
  stepPressed     Boolean     @default(false) // 3. Prensagem Térmica (160°C / 15s)
  stepQcPassed    Boolean     @default(false) // 4. Controle de Qualidade
  stepPacked      Boolean     @default(false) // 5. Embalagem
  stepCompleted   Boolean     @default(false) // 6. Concluído & Baixa de Estoque

  stockDeducted   Boolean     @default(false)
  reworkCount     Int         @default(0)
  lossReason      String?

  notes           String?
  assignedTo      String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// 7. FORNECEDORES E COMPRAS
model Supplier {
  id          String          @id @default(uuid())
  name        String
  category    String
  contactName String?
  whatsapp    String?
  email       String?
  pixKey      String?
  notes       String?
  leadTimeDays Int            @default(5)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  rawItems    RawItem[]
  purchaseOrders PurchaseOrder[]
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String             @id @default(uuid())
  orderCode    String             @unique
  supplierId   String
  supplier     Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status       PurchaseStatus     @default(DRAFT)
  totalCost    Float              @default(0.0)
  notes        String?
  orderedAt    DateTime?
  receivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  items        PurchaseOrderItem[]
  financialTx  FinancialTransaction[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawItemId       String
  rawItem         RawItem       @relation(fields: [rawItemId], references: [id], onDelete: Restrict)
  quantity        Int
  unitCost        Float
  totalCost       Float

  createdAt       DateTime      @default(now())
}

// 8. TRANSAÇÕES FINANCEIRAS
enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SALES_ORDER
  RAW_MATERIALS
  PACKAGING_SUPPLIES
  PLATFORM_FEES
  SHIPPING
  EQUIPMENT
  MARKETING
  OPERATIONAL
}

model FinancialTransaction {
  id              String              @id @default(uuid())
  type            TransactionType
  category        TransactionCategory
  amount          Float
  description     String
  date            DateTime            @default(now())
  
  orderId         String?
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

// 9. AUDIT LOG
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?
  userEmail   String?
  action      String   // ORDER_CREATED, ORDER_UPDATED, ORDER_CANCELLED, REWORK_LOGGED, PRODUCTION_COMPLETED, STOCK_ADJUSTED, etc.
  entity      String
  entityId    String
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  details     String?  // Human readable description
  oldPayload  String?
  newPayload  String?
  createdAt   DateTime @default(now())
}

// 10. VITRINE PÚBLICA & CATÁLOGO
model CatalogItem {
  id                String           @id @default(uuid())
  title             String
  description       String?
  price             Float
  imageUrl          String           // Imagem de capa principal
  backImageUrl      String?          // Imagem de costas principal
  category          String           @default("Adulto") // Adulto, Infantil, Oversized, Feminina, Regata
  showOnVirtualRack Boolean          @default(false)

  // Blend Mode & Posicionamento Dinâmico de Estampas
  baseShirtUrl      String?          // Mockup cinza liso frente
  baseShirtBackUrl  String?          // Mockup cinza liso costas
  printImageUrl     String?          // Arte/Estampa PNG isolada frente
  printBackImageUrl String?          // Arte/Estampa PNG isolada costas
  printWidth        Float?
  printTop          Float?
  printLeft         Float?
  printWidthBack    Float?
  printTopBack      Float?
  printLeftBack     Float?

  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  variants    CatalogVariant[]
}

model CatalogVariant {
  id            String      @id @default(uuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  colorName     String      // ex: "Preto", "Off-White"
  hexCode       String      @default("#000000") // ex: "#000000"
  imageUrl      String      // URL da foto desta cor
  backImageUrl  String?     // URL da foto das costas desta cor
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// 11. ORÇAMENTOS PERSONALIZADOS (LEADS DA VITRINE)
model LeadQuote {
  id              String   @id @default(uuid())
  customerName    String
  whatsapp        String
  shirtModel      String   // T-shirt tradicional, Oversized, Moletom, etc.
  size            String   // P, M, G, GG, XG, etc.
  customDesignUrl String?  // URL da arte enviada pelo cliente
  notes           String?
  status          String   @default("PENDING") // PENDING, CONTACTED, CONVERTED, ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 12. BANNERS DA VITRINE (HOME SLIDER)
model StorefrontBanner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
